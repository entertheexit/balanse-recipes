{
  "institutionId": "kbank",
  "templateId": "kbank.credit-card.v1",
  "country": "TH",
  "statementKind": "credit_card",
  "version": 1,
  "languages": ["th", "en"],
  "detection": {
    "keywordsByLanguage": {
      "th": ["กสิกรไทย", "บัตรเครดิต", "ยอดรวมทุกบัตร"],
      "en": ["KBANK", "KASIKORNBANK", "CREDIT CARD STATEMENT", "ACCOUNT SUMMARY"]
    },
    "requiredAll": ["ACCOUNT SUMMARY", "CARD NUMBER"],
    "requiredAny": ["KBANK", "KASIKORNBANK", "กสิกรไทย"],
    "negativeKeywords": ["เลขที่บัญชีเงินฝาก", "รวมถอนเงิน", "รายการเดินบัญชีเงินฝาก"]
  },
  "accountHints": {
    "regexes": [
      "(?:CARD No\\.|CARD NUMBER|เลขที[^\\s]*บัตร)\\s*(?<accountId>[0-9Xx*\\- ]{4,})",
      "(?<accountId>[0-9]{4}\\s+[0-9]{2}X{2}\\s+X{4}\\s+[0-9]{4})"
    ],
    "labelKeywords": ["CARD NUMBER", "CARD No.", "เลขที่บัตร"]
  },
  "extraction": {
    "mode": "position-table",
    "pageRegions": [
      {
        "page": 2,
        "xMin": 20,
        "xMax": 505,
        "yMin": 15,
        "yMax": 495
      },
      {
        "page": 3,
        "xMin": 20,
        "xMax": 505,
        "yMin": 15,
        "yMax": 765
      }
    ],
    "columns": [
      { "name": "date", "xMin": 20, "xMax": 75, "required": true },
      { "name": "postedDate", "xMin": 75, "xMax": 125 },
      { "name": "description", "xMin": 125, "xMax": 430, "required": true },
      { "name": "amount", "xMin": 430, "xMax": 505, "required": true }
    ],
    "rowStartRegex": "^\\d{1,2}[/-]\\d{1,2}[/-]\\d{2,4}$",
    "dateRegex": "\\d{1,2}[/-]\\d{1,2}[/-]\\d{2,4}",
    "postedDateRegex": "\\d{1,2}[/-]\\d{1,2}[/-]\\d{2,4}",
    "amountRegex": "[-+]?\\s*\\d{1,3}(?:,\\d{3})*(?:\\.\\d{2})?",
    "descriptionRules": [
      {
        "source": "columns",
        "columns": ["description"],
        "joinWith": " "
      }
    ],
    "rowGrouping": {
      "yTolerance": 3,
      "requiredColumns": ["date", "description", "amount"],
      "headerSkipKeywords": ["TRANS DATE", "POSTING DATE", "DESCRIPTION", "AMOUNT"],
      "stopBeforeKeywords": [],
      "continuationColumns": []
    },
    "directionRules": {
      "debitIndicators": [],
      "creditIndicators": [],
      "debitCodes": [],
      "creditCodes": [],
      "positiveAmountDirection": "debit",
      "negativeAmountDirection": "credit"
    }
  }
}
