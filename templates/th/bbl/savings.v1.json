{
  "institutionId": "bbl",
  "templateId": "bbl.savings.v1",
  "country": "TH",
  "statementKind": "bank_account",
  "version": 1,
  "languages": ["th", "en"],
  "detection": {
    "keywordsByLanguage": {
      "th": ["ธนาคารกรุงเทพ", "ใบแจ้งรายการบัญชีเงินฝากสะสมทรัพย์", "เลขที่บัญชี"],
      "en": ["BANGKOK BANK", "STATEMENT OF SAVING ACCOUNT", "ACCOUNT NO."]
    },
    "requiredAll": ["Bangkok Bank", "STATEMENT OF SAVING ACCOUNT", "Account No."],
    "requiredAny": ["ธนาคารกรุงเทพ", "Bangkok Bank"],
    "negativeKeywords": ["CREDIT CARD", "CARD NUMBER", "STATEMENT OF CREDIT CARD"]
  },
  "accountHints": {
    "regexes": [
      "(?:Account No\\.|Account No|เลขที่บัญชี)\\s*(?<accountId>\\d{3}-\\d-\\d{5}-\\d)",
      "(?<accountId>\\d{3}-\\d-\\d{5}-\\d)"
    ],
    "labelKeywords": ["Account No.", "เลขที่บัญชี"]
  },
  "extraction": {
    "mode": "position-table",
    "pageRegions": [
      {
        "page": "all",
        "xMin": 20,
        "xMax": 575,
        "yMin": 70,
        "yMax": 650
      }
    ],
    "columns": [
      { "name": "date", "xMin": 20, "xMax": 55, "required": true },
      { "name": "description", "xMin": 55, "xMax": 235, "required": true },
      { "name": "code", "xMin": 235, "xMax": 245 },
      { "name": "debitAmount", "xMin": 245, "xMax": 300 },
      { "name": "creditAmount", "xMin": 300, "xMax": 370 },
      { "name": "balance", "xMin": 370, "xMax": 430, "required": true },
      { "name": "channel", "xMin": 430, "xMax": 575 }
    ],
    "rowStartRegex": "^\\d{1,2}/\\d{1,2}/\\d{2,4}$",
    "dateRegex": "\\d{1,2}/\\d{1,2}/\\d{2,4}",
    "amountRegex": "[-+]?\\s*\\d{1,3}(?:,\\d{3})*(?:\\.\\d{2})?",
    "balanceRegex": "[-+]?\\s*\\d{1,3}(?:,\\d{3})*(?:\\.\\d{2})?",
    "descriptionRules": [
      {
        "source": "columns",
        "columns": ["description"],
        "joinWith": " "
      }
    ],
    "rowGrouping": {
      "yTolerance": 3,
      "requiredColumns": ["date", "description", "balance"],
      "headerSkipKeywords": [
        "Date",
        "Particulars",
        "Withdrawal",
        "Deposit",
        "Balance",
        "Via",
        "B/F"
      ],
      "stopBeforeKeywords": [
        "Total No. of Debits",
        "Total Debit Amount",
        "Total No. of Credits",
        "Total Credit Amount"
      ],
      "continuationColumns": []
    },
    "directionRules": {
      "debitIndicators": [],
      "creditIndicators": [],
      "debitCodes": [],
      "creditCodes": [],
      "positiveAmountDirection": "unknown"
    }
  }
}
